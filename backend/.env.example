# 后端环境变量模板
# 用法：cp .env.example .env，然后按需修改 .env 里的值
# .env 文件本身被 .gitignore，不会提交到 git，保证密钥安全

PORT=3000

# 数据库连接（默认值与 docker-compose.yml 一致，直接能跑）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
DB_PASSWORD=devpass

# JWT 签发密钥（生产环境必须改成随机长串！）
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
